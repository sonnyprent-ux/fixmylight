# Copy to .env and fill in. Nothing is sent until FIXMYLIGHT_DRY_RUN=false.

# --- Recipients (verify before going live!) -----------------------------
# Johannesburg Roads Agency maintains City of Johannesburg traffic signals.
FIXMYLIGHT_TO=hotline@jra.org.za
# Optional: your ward councillor, Joburg Connect, etc. Comma-separated.
FIXMYLIGHT_CC=
FIXMYLIGHT_FROM=reports@your-domain.org
FIXMYLIGHT_REPLY_TO=you@your-domain.org

# --- SMTP -----------------------------------------------------------------
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Behaviour ------------------------------------------------------------
FIXMYLIGHT_DRY_RUN=true
FIXMYLIGHT_FOLLOWUP_HOURS=24
FIXMYLIGHT_MAX_FOLLOWUPS=30
FIXMYLIGHT_SKIP_WEEKENDS=true
FIXMYLIGHT_DEDUP_RADIUS_M=75

# --- Hosted app: built-in daily scheduler (Johannesburg time) -------------
FIXMYLIGHT_SCHEDULER=false
FIXMYLIGHT_RUN_AT=07:10

# --- Other channels on the status page ------------------------------------
FIXMYLIGHT_CITY_NAME=City of Johannesburg
FIXMYLIGHT_CALL_NUMBER=0860 562 874
FIXMYLIGHT_CALL_LABEL=Joburg Connect
FIXMYLIGHT_X_HANDLES=CityofJoburgZA

# --- App ------------------------------------------------------------------
FIXMYLIGHT_DB=fixmylight.sqlite3
FIXMYLIGHT_SECRET=generate-a-long-random-string
FIXMYLIGHT_ADMIN_TOKEN=generate-another-long-random-string
FIXMYLIGHT_BASE_URL=https://fixmylight.your-domain.org

# --- Optional AI polishing (leave empty for plain templates) --------------
ANTHROPIC_API_KEY=
FIXMYLIGHT_AI_MODEL=claude-haiku-5-5
